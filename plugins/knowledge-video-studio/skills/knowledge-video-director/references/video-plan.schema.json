{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-video-studio.local/video-plan.schema.json",
  "title": "Knowledge Video Studio Plan",
  "type": "object",
  "required": ["schema_version", "project", "segments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["title", "language", "width", "height", "fps", "duration", "visual_system"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "script_path": {"type": "string"},
        "language": {"type": "string", "minLength": 2},
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 320},
        "fps": {"enum": [24, 25, 30, 50, 60]},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "quality_profile": {"enum": ["standard", "editorial-premium"]},
        "hero_scene_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "voice_strategy": {
          "type": "object",
          "properties": {
            "one_take": {"type": "boolean"},
            "speaker": {"type": "string"},
            "direction": {"type": "string"},
            "target_chars_per_second": {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "audio_strategy": {
          "type": "object",
          "properties": {
            "voice_target_lufs": {"type": "number"},
            "bgm_below_voice_db": {"type": "number", "minimum": 0},
            "sfx_max_per_40s": {"type": "integer", "minimum": 0}
          }
        },
        "visual_system": {
          "type": "object",
          "required": ["palette", "typefaces", "motion_character"],
          "properties": {
            "palette": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "typefaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "motion_character": {"type": "string"},
            "anchor": {
              "type": "object",
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "continuity_strategy": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "narration", "intent", "visual_mode", "reason", "transition", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string"},
          "intent": {"type": "string", "minLength": 1},
          "visual_anchor_id": {"type": "string"},
          "evidence_role": {"enum": ["evidence", "context", "mechanism", "mood", "none"]},
          "visual_mode": {"enum": ["stock", "hyperframes", "remotion", "editorial_collage", "hybrid"]},
          "reason": {"type": "string", "minLength": 1},
          "media": {
            "type": "object",
            "properties": {
              "queries": {"type": "array", "items": {"type": "string"}},
              "selected_asset_id": {"type": ["string", "null"]},
              "usage": {"type": "string"}
            }
          },
          "render": {
            "type": "object",
            "properties": {
              "brief": {"type": "string"},
              "preset": {"type": "string"},
              "data": {"type": "object"}
            }
          },
          "transition": {"enum": ["cut", "fade", "dip_to_color", "match_cut", "chapter"]},
          "status": {"enum": ["planned", "sourced", "rendered", "approved", "blocked"]},
          "fact_check": {"type": "array", "items": {"type": "string"}},
          "risk_flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
